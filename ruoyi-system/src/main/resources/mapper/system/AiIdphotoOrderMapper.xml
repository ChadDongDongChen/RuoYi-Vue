<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AiIdphotoOrderMapper">

    <resultMap type="AiIdphotoOrder" id="AiIdphotoOrderResult">
        <result property="orderId"       column="order_id"       />
        <result property="orderNo"       column="order_no"       />
        <result property="userId"        column="user_id"        />
        <result property="specId"        column="spec_id"        />
        <result property="specName"      column="spec_name"      />
        <result property="background"    column="background"     />
        <result property="beauty"        column="beauty"         />
        <result property="suit"          column="suit"           />
        <result property="originalUrl"   column="original_url"   />
        <result property="resultUrl"     column="result_url"     />
        <result property="amount"        column="amount"         />
        <result property="status"        column="status"         />
        <result property="payTime"       column="pay_time"       />
        <result property="payType"       column="pay_type"       />
        <result property="transactionId" column="transaction_id" />
        <result property="expireTime"    column="expire_time"    />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"        column="remark"         />
    </resultMap>

    <sql id="selectOrderVo">
        select order_id, order_no, user_id, spec_id, spec_name, background, beauty, suit, original_url, result_url, amount, status, pay_time, pay_type, transaction_id, expire_time, create_by, create_time, update_by, update_time, remark
        from ai_idphoto_order
    </sql>

    <select id="selectAiIdphotoOrderList" parameterType="AiIdphotoOrder" resultMap="AiIdphotoOrderResult">
        <include refid="selectOrderVo"/>
        <where>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="orderNo != null and orderNo != ''">
                AND order_no like concat('%', #{orderNo}, '%')
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectAiIdphotoOrderByOrderNo" parameterType="String" resultMap="AiIdphotoOrderResult">
        <include refid="selectOrderVo"/>
        where order_no = #{orderNo}
    </select>

    <select id="selectAiIdphotoOrderById" parameterType="Long" resultMap="AiIdphotoOrderResult">
        <include refid="selectOrderVo"/>
        where order_id = #{orderId}
    </select>

    <insert id="insertAiIdphotoOrder" parameterType="AiIdphotoOrder" useGeneratedKeys="true" keyProperty="orderId">
        insert into ai_idphoto_order
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">order_no,</if>
            <if test="userId != null">user_id,</if>
            <if test="specId != null">spec_id,</if>
            <if test="specName != null and specName != ''">spec_name,</if>
            <if test="background != null and background != ''">background,</if>
            <if test="beauty != null and beauty != ''">beauty,</if>
            <if test="suit != null and suit != ''">suit,</if>
            <if test="originalUrl != null and originalUrl != ''">original_url,</if>
            <if test="resultUrl != null and resultUrl != ''">result_url,</if>
            <if test="amount != null">amount,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="payType != null and payType != ''">pay_type,</if>
            <if test="expireTime != null">expire_time,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderNo != null and orderNo != ''">#{orderNo},</if>
            <if test="userId != null">#{userId},</if>
            <if test="specId != null">#{specId},</if>
            <if test="specName != null and specName != ''">#{specName},</if>
            <if test="background != null and background != ''">#{background},</if>
            <if test="beauty != null and beauty != ''">#{beauty},</if>
            <if test="suit != null and suit != ''">#{suit},</if>
            <if test="originalUrl != null and originalUrl != ''">#{originalUrl},</if>
            <if test="resultUrl != null and resultUrl != ''">#{resultUrl},</if>
            <if test="amount != null">#{amount},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="payType != null and payType != ''">#{payType},</if>
            <if test="expireTime != null">#{expireTime},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateAiIdphotoOrder" parameterType="AiIdphotoOrder">
        update ai_idphoto_order
        <trim prefix="SET" suffixOverrides=",">
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="resultUrl != null">result_url = #{resultUrl},</if>
            <if test="payTime != null">pay_time = #{payTime},</if>
            <if test="payType != null">pay_type = #{payType},</if>
            <if test="transactionId != null">transaction_id = #{transactionId},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </trim>
        where order_id = #{orderId}
    </update>

    <update id="updatePayStatus">
        update ai_idphoto_order
        set status = #{status}, pay_time = #{payTime}, update_time = sysdate()
        where order_no = #{orderNo}
    </update>

    <update id="updateResultUrl">
        update ai_idphoto_order
        set result_url = #{resultUrl}, update_time = sysdate()
        where order_no = #{orderNo}
    </update>

    <select id="selectExpiredOrders" resultMap="AiIdphotoOrderResult">
        <include refid="selectOrderVo"/>
        where status = '0' and expire_time &lt; #{now}
    </select>

</mapper>
